# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.

# User id used by the Airflow containers (on Linux use: id -u). 50000 is fine on Windows/macOS.
AIRFLOW_UID=50000

# Packages installed into the Airflow containers at start-up (quick setup).
# For production, build a custom image instead.
_PIP_ADDITIONAL_REQUIREMENTS=databricks-sdk dbt-databricks

# Databricks workspace used by the ingestion task (read by the Databricks SDK).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-personal-access-token>

# Optional: encrypts Airflow connection passwords. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=
